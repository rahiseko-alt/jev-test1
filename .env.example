# このファイルを .env にコピーし、自分の鍵を入れてください。
# .env はリポジトリに入れないでください（.gitignore 済み）。

# --- 必須 ---

# 判定に使う Jev の鍵。https://console.typesafe.ai/settings/keys で取得します。
TYPESAFE_API_KEY=

# Web検索に使う Tavily の鍵。https://tavily.com で取得します（無料枠あり）。
TAVILY_API_KEY=

# 入口の聞き取りに使う生成AIの鍵。
ANTHROPIC_API_KEY=

# --- 任意 ---

# データベースの種類。sqlite（既定）または postgres。
DATABASE_KIND=sqlite

# sqlite のときのファイル置き場。
SQLITE_PATH=./data/factchecker.db

# postgres のときの接続先。DATABASE_KIND=postgres のときのみ必須。
# DATABASE_URL=postgres://user:password@localhost:5432/factchecker

# 既存のファクトチェック結果を検索する場合に設定します。
GOOGLE_FACTCHECK_API_KEY=

# Crossref に連絡先を伝えると、利用できる回数の上限が緩みます。
CROSSREF_MAILTO=

# 入口の聞き取りに使うモデル。
INTAKE_MODEL=claude-sonnet-5
